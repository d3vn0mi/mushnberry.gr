---
import { useTranslations, getNavLinks } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const navLinks = getNavLinks(lang);
---

<footer class="site-footer">
  <div class="footer-accent-line"></div>
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">
        <svg class="logo-mark" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6 26 Q24 4 42 26" stroke="#C2185B" stroke-width="3" fill="none" stroke-linecap="round"/>
          <path d="M11 24 Q24 10 37 24" stroke="#5D4037" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.5"/>
          <path d="M10 42 L10 22 L24 34 L38 22 L38 42" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M38 16 C42 10, 47 13, 44 18" fill="#2E7D32"/>
          <circle cx="42" cy="20" r="2" fill="#C2185B"/>
        </svg>
        <span class="logo-text">Mushnberry</span>
      </div>
      <p class="footer-tagline">{t('footer.tagline')}</p>
    </div>

    <nav class="footer-nav">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-contact">
      <p>{t('contact.info.email')}</p>
      <p>{t('contact.info.phone')}</p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>{t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .footer-accent-line {
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent), var(--color-green));
  }

  .site-footer {
    background-color: var(--color-dark);
    color: var(--color-text);
    padding-top: 3rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
  }

  .footer-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .footer-contact p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem 0;
    text-align: center;
  }

  .footer-bottom p {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    margin: 0;
  }
</style>
