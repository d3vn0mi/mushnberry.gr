---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('el');
---

<BaseLayout title={t('nav.about')} description={t('about.hero.subtitle')}>
  <Hero title={t('about.hero.title')} subtitle={t('about.hero.subtitle')} variant="brown" />

  <section class="section">
    <div class="container content-block">
      <h2>{t('about.story.title')}</h2>
      <p>{t('about.story.p1')}</p>
      <p>{t('about.story.p2')}</p>
    </div>
  </section>

  <section class="section section-primary">
    <div class="container text-center">
      <h2>{t('about.mission.title')}</h2>
      <p class="mission-text">{t('about.mission.desc')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="text-center">{t('about.values.title')}</h2>
      <div class="grid-3 values-grid">
        <Card
          title={t('about.values.quality')}
          description={t('about.values.quality.desc')}
          icon="✓"
        />
        <Card
          title={t('about.values.sustainability')}
          description={t('about.values.sustainability.desc')}
          icon="♻"
        />
        <Card
          title={t('about.values.innovation')}
          description={t('about.values.innovation.desc')}
          icon="⚡"
        />
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container content-block">
      <h2>{t('about.facility.title')}</h2>
      <p>{t('about.facility.desc')}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .content-block {
    max-width: 800px;
  }

  .content-block h2 {
    margin-bottom: 1.5rem;
    color: var(--color-secondary-dark);
  }

  .content-block p {
    line-height: 1.8;
    color: #444;
  }

  .section-dark .content-block h2 {
    color: var(--color-accent);
  }

  .section-dark .content-block p {
    color: var(--color-text);
    opacity: 0.9;
  }

  .mission-text {
    max-width: 700px;
    margin: 1rem auto 0;
    font-size: 1.15rem;
    line-height: 1.8;
    opacity: 0.95;
  }

  .values-grid {
    margin-top: 2rem;
  }
</style>
