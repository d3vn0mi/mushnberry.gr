---
export interface Props {
  title: string;
  subtitle?: string;
  variant?: 'primary' | 'dark' | 'brown';
}

const { title, subtitle, variant = 'dark' } = Astro.props;

const bgClass = {
  primary: 'hero-primary',
  dark: 'hero-dark',
  brown: 'hero-brown',
}[variant];
---

<section class:list={['hero', bgClass]}>
  <div class="container hero-inner">
    <h1>{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    padding: 5rem 0 4rem;
    text-align: center;
    color: var(--color-text);
  }

  .hero-dark {
    background: linear-gradient(135deg, var(--color-dark) 0%, #16213e 100%);
  }

  .hero-primary {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  }

  .hero-brown {
    background: linear-gradient(135deg, var(--color-secondary-dark) 0%, var(--color-secondary) 100%);
  }

  .hero-inner {
    max-width: 800px;
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    opacity: 0.9;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
</style>
