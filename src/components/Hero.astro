---
export interface Props {
  title: string;
  subtitle?: string;
  variant?: 'primary' | 'dark' | 'brown';
  image?: string;
  fullHeight?: boolean;
}

const { title, subtitle, variant = 'dark', image, fullHeight = false } = Astro.props;

const overlayClass = {
  primary: 'overlay-primary',
  dark: 'overlay-dark',
  brown: 'overlay-brown',
}[variant];

const bgClass = {
  primary: 'hero-primary',
  dark: 'hero-dark',
  brown: 'hero-brown',
}[variant];
---

<section class:list={['hero', bgClass, { 'hero-full': fullHeight }]}>
  {image && (
    <img
      src={`/images/${image}`}
      alt=""
      class="hero-bg-image"
      loading="eager"
      width="1920"
      height="1080"
    />
  )}
  <div class:list={['hero-overlay', overlayClass]}></div>
  <div class="container hero-inner">
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    <div class="hero-actions">
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0 5rem;
    text-align: center;
    color: var(--color-text);
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-full {
    min-height: 100vh;
    padding: 8rem 0;
  }

  .hero-dark {
    background: linear-gradient(135deg, var(--color-dark) 0%, #16213e 100%);
  }
  .hero-primary {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  }
  .hero-brown {
    background: linear-gradient(135deg, var(--color-secondary-dark) 0%, var(--color-secondary) 100%);
  }

  .hero-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .overlay-dark {
    background: linear-gradient(
      135deg,
      rgba(26, 26, 46, 0.8) 0%,
      rgba(26, 26, 46, 0.6) 100%
    );
  }
  .overlay-primary {
    background: linear-gradient(
      135deg,
      rgba(154, 18, 72, 0.75) 0%,
      rgba(194, 24, 91, 0.55) 100%
    );
  }
  .overlay-brown {
    background: linear-gradient(
      135deg,
      rgba(62, 39, 35, 0.75) 0%,
      rgba(93, 64, 55, 0.55) 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .hero-title {
    animation: hero-fade-up 0.8s ease both;
    animation-delay: 0.1s;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    opacity: 0.9;
    line-height: 1.6;
    margin-bottom: 2rem;
    animation: hero-fade-up 0.8s ease both;
    animation-delay: 0.3s;
  }

  .hero-actions {
    animation: hero-fade-up 0.8s ease both;
    animation-delay: 0.5s;
  }
</style>
