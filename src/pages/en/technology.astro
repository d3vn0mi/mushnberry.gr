---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Card from '../../components/Card.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<BaseLayout title={t('nav.technology')} description={t('tech.hero.subtitle')}>
  <Hero title={t('tech.hero.title')} subtitle={t('tech.hero.subtitle')} variant="dark" />

  <section class="section">
    <div class="container content-block">
      <h2>{t('tech.how.title')}</h2>
      <p>{t('tech.how.desc')}</p>
    </div>
  </section>

  <section class="section section-brown">
    <div class="container">
      <div class="grid-3">
        <Card
          title={t('tech.sensors.title')}
          description={t('tech.sensors.desc')}
          icon="📡"
        />
        <Card
          title={t('tech.climate.title')}
          description={t('tech.climate.desc')}
          icon="🌡️"
        />
        <Card
          title={t('tech.data.title')}
          description={t('tech.data.desc')}
          icon="📊"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="text-center">{t('tech.benefits.title')}</h2>
      <div class="grid-3 benefits-grid">
        <div class="benefit-item">
          <div class="benefit-number">+40%</div>
          <h3>{t('tech.benefits.yield')}</h3>
          <p>{t('tech.benefits.yield.desc')}</p>
        </div>
        <div class="benefit-item">
          <div class="benefit-number">-60%</div>
          <h3>{t('tech.benefits.waste')}</h3>
          <p>{t('tech.benefits.waste.desc')}</p>
        </div>
        <div class="benefit-item">
          <div class="benefit-number">365</div>
          <h3>{t('tech.benefits.quality')}</h3>
          <p>{t('tech.benefits.quality.desc')}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .content-block {
    max-width: 800px;
  }

  .content-block h2 {
    margin-bottom: 1.5rem;
    color: var(--color-secondary-dark);
  }

  .content-block p {
    line-height: 1.8;
    color: #444;
    font-size: 1.05rem;
  }

  .benefits-grid {
    margin-top: 2.5rem;
  }

  .benefit-item {
    text-align: center;
    padding: 2rem;
  }

  .benefit-number {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .benefit-item h3 {
    color: var(--color-secondary-dark);
    margin-bottom: 0.5rem;
  }

  .benefit-item p {
    color: #555;
    line-height: 1.6;
  }
</style>
